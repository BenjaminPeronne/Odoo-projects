{
  "name": "odoo-manager-next",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:desktop": "cross-env ELECTRON_BUILD=1 next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir --publish never",
    "desktop:dist": "electron-builder --publish never",
    "test:desktop": "node --test electron/tests/*.test.cjs"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "main": "electron/main.cjs",
  "homepage": "https://github.com/BenjaminPeronne/Odoo-projects",
  "desktopName": "com.sudokeys.odoo-manager.desktop",
  "description": "Gestionnaire local des projets Odoo Sudokeys",
  "author": {
    "name": "Sudokeys"
  }
}
